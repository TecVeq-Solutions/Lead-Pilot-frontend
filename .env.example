# LeadPilot Desktop Client Environment Variables

# Backend REST API endpoint (default: http://localhost:8000/api/v1)
VITE_API_URL=http://localhost:8000/api/v1

# Laravel Reverb / Pusher WebSocket Connection
VITE_REVERB_APP_KEY=leadpilot_key
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http
